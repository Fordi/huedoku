{
  "name": "huedoku",
  "version": "0.0.1",
  "description": "Solve a grid of colors with two rules: one winner per row/column/color; winners cannot touch.",
  "main": "bin/start.ts",
  "bin": "bin/start.ts",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "preinstall": "node bin/sync-web-dependencies.ts || npm i",
    "start": "node --watch bin/start.ts",
    "build": "node bin/build-static.ts",
    "test": "node --test",
    "only": "node --test --test-only",
    "coverage": "c8 --reporter=html --reporter=lcov --all --include 'src/**' --exclude 'test/**' --exclude 'migrations/**' node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix; node bin/generate-project-layout.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish": "npm run build && scp dist/* fordi.org:www/fordi.org/huedoku"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fordi-org/valid": "^1.0.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  },
  "webDependencies": {
    "preact": "^10.29.8",
    "preact/hooks": true,
    "htm": "^3.1.1",
    "htm/preact": true,
    "@fordi-org/valid": "^1.0.0"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "node"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
