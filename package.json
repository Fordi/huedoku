{
  "name": "my-app",
  "version": "0.0.1",
  "description": "My awesome web app",
  "main": "bin/start.ts",
  "bin": "bin/start.ts",
  "exports": {
    "node": "./src/index.ts"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "preinstall": "node bin/sync-web-dependencies.ts || npm i",
    "start": "node --watch bin/start.ts",
    "test": "node --test",
    "only": "node --test --test-only",
    "coverage": "c8 --reporter=html --reporter=lcov --all --include 'src/**' --exclude 'test/**' --exclude 'migrations/**' node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix; node bin/generate-project-layout.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "svc:start": "npx @fordi-org/sdn control start",
    "svc:logs": "npx @fordi-org/sdn logs",
    "svc:stop": "npx @fordi-org/sdn control stop",
    "svc:install": "npx @fordi-org/sdn install --force"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fordi-org/sdn": "^0.0.6",
    "cookie-session": "^2.1.1",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "htm": "^3.1.1",
    "knex": "^3.3.0",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0",
    "preact": "^10.29.7",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "yaml": "^2.9.0"
  },
  "webDependencies": {
    "preact": "^10.29.7",
    "preact/hooks": true,
    "htm": "^3.1.1",
    "htm/preact": true,
    "zod": "^4.4.3"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "node"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
