# Copy this file to .env (or .env.development / .env.production / .env.test)
# and fill in the values below. See docs/deployment.md for the full reference.

# NODE_ENV=development
# PORT=3000

# Signs the session cookie. Min 16 chars - generate with `openssl rand -hex 32`.
SESSION_SECRET=

# From your GitHub OAuth App - see docs/auth.md for how to create one.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# mysql://, postgres://, a relative sqlite path (e.g. ./data.sqlite3), or :memory:
# See docs/database.md.
DATABASE_URL=./data.sqlite3

# Comma-separated GitHub logins bootstrapped to `admin` on first login.
# ADMIN_GITHUB_LOGINS=

# Mounts the whole API under a path prefix, e.g. /my-app.
# BASE_PATH=
